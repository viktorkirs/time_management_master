<Window x:Class="TimeManagementMaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        xmlns:loc="clr-namespace:TimeManagementMaster"
        Title="{loc:Loc AppTitle}" Icon="pack://application:,,,/TimeManagementMaster;component/Assets/logo.png"
        Width="1380" Height="900" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource SidebarBrush}" Padding="20,28,20,20">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Border Background="{StaticResource AccentBrush}" CornerRadius="10" Width="36" Height="36">
              <TextBlock Text="T" Foreground="White" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="TIME / TEAM" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
          </StackPanel>
          <TextBlock Text="{loc:Loc AppShort}" Foreground="#9AABBF" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,32"/>
          <Button Content="{loc:Loc Planning}" Style="{StaticResource NavActiveButton}" Click="Planning_Click"/>
          <Button Content="{loc:Loc Sites}" Style="{StaticResource NavButton}" Click="Sites_Click"/>
          <Button Content="{loc:Loc Employees}" Style="{StaticResource NavButton}" Click="Employees_Click"/>
          <Button Content="{loc:Loc HoursReport}" Style="{StaticResource NavButton}" Click="MonthlyHours_Click"/>
          <Border Height="1" Background="#2E3E52" Margin="0,20"/>
          <TextBlock Text="{loc:Loc QuickCreate}" Foreground="#9AABBF" FontSize="11" FontWeight="SemiBold" Margin="12,0,0,12"/>
          <Button Content="{loc:Loc AddSite}" Style="{StaticResource NavButton}" Click="AddSite_Click"/>
          <Button Content="{loc:Loc AddEmployee}" Style="{StaticResource NavButton}" Click="AddEmployee_Click"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Border Background="#23364A" CornerRadius="10" Padding="14" Margin="0,0,0,20">
            <StackPanel>
              <TextBlock Text="{loc:Loc LocalWorkspace}" Foreground="#E4EDF6" FontWeight="SemiBold" FontSize="12"/>
              <TextBlock Text="{loc:Loc LocalWorkspaceHint}" Foreground="#9AABBF" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <TextBlock Text="{loc:Loc Language}" Foreground="#9AABBF" FontSize="11" Margin="0,0,0,6"/>
          <ComboBox x:Name="LangBox" DisplayMemberPath="Title" SelectionChanged="Lang_Changed"/>
        </StackPanel>
        <Border/>
      </DockPanel>
    </Border>
    <DockPanel Grid.Column="1" Margin="28,24,28,12">
      <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{loc:Loc Planning}" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock Text="{loc:Loc PlanningHint}" Style="{StaticResource MutedText}" Margin="0,5,16,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="{loc:Loc LeaveRegister}" Click="Absence_Click"/>
          <Button Content="{loc:Loc AssignPeople}" Style="{StaticResource PrimaryButton}" Margin="0" Click="Assign_Click"/>
        </StackPanel>
      </Grid>
      <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,-12,20">
        <Border Style="{StaticResource MetricCard}">
          <StackPanel><TextBlock Text="{loc:Loc Employees}" Style="{StaticResource SectionLabel}"/>
            <TextBlock x:Name="TeamCount" Style="{StaticResource MetricValue}"/>
            <TextBlock Text="{loc:Loc ActiveTeam}" Style="{StaticResource MutedText}" FontSize="11"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource MetricCard}">
          <StackPanel><TextBlock Text="{loc:Loc AssignedPeople}" Style="{StaticResource SectionLabel}"/>
            <TextBlock x:Name="AssignedCount" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock x:Name="HeadcountText" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource MetricCard}" Background="{StaticResource WarmBrush}">
          <StackPanel><TextBlock Text="{loc:Loc UnassignedPlural}" Style="{StaticResource SectionLabel}"/>
            <TextBlock x:Name="UnassignedCount" Style="{StaticResource MetricValue}" Foreground="#946125"/>
            <TextBlock x:Name="UnassignedHint" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource MetricCard}">
          <StackPanel><TextBlock Text="{loc:Loc Absences}" Style="{StaticResource SectionLabel}"/>
            <TextBlock x:Name="AbsentCount" Style="{StaticResource MetricValue}"/>
            <TextBlock x:Name="SummaryDate" Style="{StaticResource MutedText}" FontSize="11"/>
          </StackPanel>
        </Border>
      </UniformGrid>
      <Border DockPanel.Dock="Top" Background="{StaticResource PaperBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
        <StackPanel>
          <DockPanel Margin="0,0,0,14" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <RadioButton x:Name="BySiteRadio" Content="{loc:Loc BySite}" GroupName="ViewMode" Style="{StaticResource SegmentButton}" IsChecked="True" Checked="ViewChanged"/>
              <RadioButton x:Name="ByEmployeeRadio" Content="{loc:Loc ByEmployee}" GroupName="ViewMode" Style="{StaticResource SegmentButton}" Checked="ViewChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <Button Content="‹" Style="{StaticResource IconButton}" Click="Prev_Click" ToolTip="{loc:Loc PreviousPeriod}"/>
              <Button Content="›" Style="{StaticResource IconButton}" Margin="4,0,12,0" Click="Next_Click" ToolTip="{loc:Loc NextPeriod}"/>
              <TextBlock x:Name="RangeLabel" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <Button Content="{loc:Loc Today}" Margin="0" Click="Today_Click"/>
            </StackPanel>
          </DockPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="{loc:Loc JumpDate}" Style="{StaticResource FormLabel}"/>
              <DatePicker x:Name="JumpDate" SelectedDateChanged="JumpDate_Changed"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
              <TextBlock Text="{loc:Loc FindEmployee}" Style="{StaticResource FormLabel}"/>
              <TextBox x:Name="SearchBox" TextChanged="FilterChanged" ToolTip="{loc:Loc SearchEmployeeHint}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,12,0">
              <TextBlock Text="{loc:Loc Site}" Style="{StaticResource FormLabel}"/>
              <ComboBox x:Name="SiteFilter" DisplayMemberPath="Title" SelectionChanged="FilterChanged"/>
            </StackPanel>
            <Button Grid.Column="3" Content="{loc:Loc ResetFilters}" VerticalAlignment="Bottom" Margin="0" Click="ResetFilters_Click"/>
          </Grid>
        </StackPanel>
      </Border>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="{loc:Loc AddSite}" Click="AddSite_Click"/>
          <Button Content="{loc:Loc MoreActions}" Margin="0" Click="More_Click">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{loc:Loc Move}" Click="Move_Click"/>
                <MenuItem Header="{loc:Loc ClearDays}" Click="Clear_Click"/>
                <Separator/>
                <MenuItem Header="{loc:Loc CopyDay}" Click="CopyDay_Click"/>
                <MenuItem Header="{loc:Loc CopyWeek}" Click="CopyWeek_Click"/>
                <Separator/>
                <MenuItem Header="{loc:Loc PrintDay}" Click="PrintDay_Click"/>
                <MenuItem Header="{loc:Loc PrintWeek}" Click="PrintWeek_Click"/>
                <MenuItem Header="{loc:Loc ExportCsv}" Click="Export_Click"/>
                <Separator/>
                <MenuItem Header="{loc:Loc Backup}" Click="Backup_Click"/>
                <MenuItem Header="{loc:Loc Restore}" Click="Restore_Click"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="BoardTitle" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
          <StackPanel x:Name="RangePanel" Orientation="Horizontal" Visibility="Collapsed">
            <RadioButton x:Name="DayRadio" Content="{loc:Loc Day}" GroupName="RangeMode" Style="{StaticResource SegmentButton}" IsChecked="True" Checked="RangeChanged"/>
            <RadioButton x:Name="WeekRadio" Content="{loc:Loc Week}" GroupName="RangeMode" Style="{StaticResource SegmentButton}" Checked="RangeChanged"/>
            <RadioButton x:Name="MonthRadio" Content="{loc:Loc Month}" GroupName="RangeMode" Style="{StaticResource SegmentButton}" Checked="RangeChanged"/>
          </StackPanel>
        </StackPanel>
      </DockPanel>
      <DockPanel x:Name="QuickCalendarBar" DockPanel.Dock="Top" Margin="0,0,0,12" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
          <Button Content="{loc:Loc Vacation}" Click="Vacation_Click"/>
          <Button Content="{loc:Loc Sick}" Click="Sick_Click" Margin="0"/>
        </StackPanel>
        <TextBlock Text="{loc:Loc CalendarHelp}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
      <Grid>
        <ScrollViewer x:Name="SiteScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0"><StackPanel x:Name="SitePanel"/></ScrollViewer>
        <DataGrid x:Name="EmployeeGrid" Visibility="Collapsed" SelectionUnit="Cell" SelectionMode="Extended" FrozenColumnCount="1"
                  CanUserResizeRows="False" RowHeight="64" FontSize="13" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  MouseDoubleClick="Calendar_DoubleClick" PreviewMouseRightButtonDown="Calendar_RightClick" ContextMenuOpening="CalendarMenu_Opening"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{loc:Loc EditWorkDay}" Click="EditWorkDay_Click"/>
              <Separator/>
              <MenuItem Header="{loc:Loc Vacation}" Click="Vacation_Click"/>
              <MenuItem Header="{loc:Loc Sick}" Click="Sick_Click"/>
              <MenuItem Header="{loc:Loc Unpaid}" Click="Unpaid_Click"/>
              <MenuItem Header="{loc:Loc Other}" Click="OtherAbsence_Click"/>
              <Separator/>
              <MenuItem Header="{loc:Loc AllEmployeeAbsences}" Click="Absence_Click"/>
            </ContextMenu>
          </DataGrid.ContextMenu>
        </DataGrid>
        <Border x:Name="EmptyState" Visibility="Collapsed" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource PaperBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="32"><StackPanel x:Name="EmptyBody"/></Border>
      </Grid>
    </DockPanel>
  </Grid>
</Window>
