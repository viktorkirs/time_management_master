<Window x:Class="TimeManagementMaster.SitesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        xmlns:loc="clr-namespace:TimeManagementMaster"
        Title="{loc:Loc Sites}" Height="650" Width="1080" MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="24">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,24">
      <Button DockPanel.Dock="Right" Content="{loc:Loc CreateSite}" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0" VerticalAlignment="Center" Click="Add_Click"/>
      <StackPanel>
        <TextBlock Text="{loc:Loc Sites}" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock Text="{loc:Loc SiteDirectoryHint}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
      </StackPanel>
    </DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc SearchSites}" Style="{StaticResource FormLabel}"/>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <CheckBox DockPanel.Dock="Right" x:Name="ArchiveBox" Content="{loc:Loc ShowArchive}" VerticalAlignment="Center" Margin="12,0,0,0" Checked="Reload" Unchecked="Reload"/>
      <TextBox x:Name="SearchBox" TextChanged="Reload" AutomationProperties.Name="{loc:Loc SearchSites}"/>
    </DockPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <Button DockPanel.Dock="Right" Content="{loc:Loc Close}" Margin="0" IsCancel="True"/>
      <WrapPanel>
        <Button x:Name="AssignButton" Content="{loc:Loc Assign}" Style="{StaticResource PrimaryButton}" Click="Assign_Click"/>
        <Button x:Name="EditButton" Content="{loc:Loc Edit}" Click="Edit_Click"/>
        <Button x:Name="CardButton" Content="{loc:Loc Card}" Click="Card_Click"/>
        <Button x:Name="ArchiveButton" Content="{loc:Loc ToArchive}" Click="Archive_Click"/>
        <Button x:Name="RestoreButton" Content="{loc:Loc RestoreArchive}" Click="Restore_Click"/>
      </WrapPanel>
    </DockPanel>
    <Grid>
    <DataGrid x:Name="Grid" SelectionMode="Single" MouseDoubleClick="Edit_Click" SelectionChanged="Selection_Changed" RowHeight="46">
      <DataGrid.Columns>
        <DataGridTextColumn Binding="{Binding Name}" Width="180">
          <DataGridTextColumn.Header><TextBlock Text="{loc:Loc SiteName}"/></DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridTextColumn Binding="{Binding Address}" Width="*">
          <DataGridTextColumn.Header><TextBlock Text="{loc:Loc Address}"/></DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridTextColumn Binding="{Binding ContactName}" Width="140">
          <DataGridTextColumn.Header><TextBlock Text="{loc:Loc Contact}"/></DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridTextColumn Binding="{Binding Phone}" Width="130">
          <DataGridTextColumn.Header><TextBlock Text="{loc:Loc Phone}"/></DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridTextColumn Binding="{Binding Note}" Width="150">
          <DataGridTextColumn.Header><TextBlock Text="{loc:Loc Note}"/></DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridCheckBoxColumn Binding="{Binding IsArchived, Mode=OneWay}" IsReadOnly="True" Width="80">
          <DataGridCheckBoxColumn.Header><TextBlock Text="{loc:Loc Archive}"/></DataGridCheckBoxColumn.Header>
        </DataGridCheckBoxColumn>
      </DataGrid.Columns>
    </DataGrid>
      <TextBlock x:Name="EmptyText" Text="{loc:Loc NoSitesFound}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" TextAlignment="Center" Style="{StaticResource MutedText}"/>
    </Grid>
  </DockPanel>
</Window>
