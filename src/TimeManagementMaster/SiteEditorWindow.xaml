<Window x:Class="TimeManagementMaster.SiteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        xmlns:loc="clr-namespace:TimeManagementMaster"
        Width="580" Height="610" MinHeight="480" MinWidth="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="28">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
      <TextBlock x:Name="Heading" FontSize="25" FontWeight="SemiBold"/>
      <TextBlock x:Name="Hint" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12" AutomationProperties.LiveSetting="Assertive"/>
      <CheckBox x:Name="AssignNext" Content="{loc:Loc AssignAfterCreate}" Margin="0,0,0,16"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{loc:Loc Cancel}" MinWidth="100" IsCancel="True"/>
        <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" MinWidth="150" Margin="0" IsDefault="True" Click="Save_Click"/>
      </StackPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
      <StackPanel>
        <TextBlock Text="{loc:Loc SiteNameStar}" Style="{StaticResource FormLabel}"/>
        <TextBox x:Name="NameBox" TextChanged="Name_Changed" AutomationProperties.Name="{loc:Loc SiteName}"/>
        <TextBlock Text="{loc:Loc SiteNameExample}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,20"/>
        <TextBlock Text="{loc:Loc OptionalAddress}" Style="{StaticResource FormLabel}"/>
        <TextBox x:Name="AddressBox" AutomationProperties.Name="{loc:Loc Address}" Margin="0,0,0,24"/>
        <Expander x:Name="Details" Header="{loc:Loc SiteExtraDetails}" Foreground="{StaticResource MutedBrush}">
          <StackPanel Margin="0,16,0,0">
            <TextBlock Text="{loc:Loc Contact}" Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="ContactBox" AutomationProperties.Name="{loc:Loc Contact}" Margin="0,0,0,12"/>
            <TextBlock Text="{loc:Loc Phone}" Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="PhoneBox" MaxLength="40" AutomationProperties.Name="{loc:Loc Phone}" Margin="0,0,0,12"/>
            <TextBlock Text="{loc:Loc Note}" Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" VerticalContentAlignment="Top" AutomationProperties.Name="{loc:Loc Note}"/>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
