<Window x:Class="TimeManagementMaster.CopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        xmlns:loc="clr-namespace:TimeManagementMaster"
        Title="{loc:Loc Copy}" Height="420" Width="560" MinWidth="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="Height">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{loc:Loc Cancel}" IsCancel="True" MinWidth="110"/>
      <Button Content="{loc:Loc CopyAction}" Style="{StaticResource PrimaryButton}" MinWidth="140" Margin="0" Click="Save_Click"/>
    </StackPanel>
    <StackPanel>
      <TextBlock x:Name="HintText" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TextBlock x:Name="SourceLabel" Margin="0,0,0,4"/>
      <DatePicker x:Name="SourceDate"/>
      <TextBlock Text="{loc:Loc CopyTarget}" Margin="0,12,0,4"/>
      <StackPanel Orientation="Horizontal">
        <DatePicker x:Name="TargetFrom"/>
        <TextBlock Text="—" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <DatePicker x:Name="TargetTo"/>
      </StackPanel>
      <CheckBox x:Name="WeekdaysOnly" Content="{loc:Loc WeekdaysOnly}" IsChecked="True" Margin="0,12,0,0"/>
      <TextBlock Text="{loc:Loc CopyFootnote}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
    </StackPanel>
  </DockPanel>
</Window>
