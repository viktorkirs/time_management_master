<Window x:Class="TimeManagementMaster.SiteCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        xmlns:loc="clr-namespace:TimeManagementMaster"
        Title="{loc:Loc SiteCard}" Height="560" Width="720" MinHeight="400" MinWidth="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <Button DockPanel.Dock="Right" Content="{loc:Loc Edit}" Click="Edit_Click" Margin="12,0,0,0" VerticalAlignment="Top"/>
      <StackPanel>
        <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="ContactText" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
      </StackPanel>
    </DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="{loc:Loc FromWord}" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <DatePicker x:Name="FromDate"/>
      <TextBlock Text="{loc:Loc ToWord}" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <DatePicker x:Name="ToDate"/>
      <Button Content="{loc:Loc Show}" Click="Show_Click"/>
      <Button x:Name="AssignButton" Content="{loc:Loc Assign}" Style="{StaticResource PrimaryButton}" Margin="0" Click="Assign_Click"/>
    </StackPanel>
    <Button DockPanel.Dock="Bottom" Content="{loc:Loc Close}" HorizontalAlignment="Right" Margin="0,12,0,0" IsCancel="True"/>
    <TextBlock DockPanel.Dock="Top" x:Name="EmptyText" Margin="0,0,0,6" Visibility="Collapsed"/>
    <DataGrid x:Name="Grid">
      <DataGrid.Columns>
        <DataGridTextColumn Binding="{Binding DateText}" Width="120">
          <DataGridTextColumn.Header><TextBlock Text="{loc:Loc Dates}"/></DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridTextColumn Binding="{Binding EmployeeName}" Width="*">
          <DataGridTextColumn.Header><TextBlock Text="{loc:Loc Employee}"/></DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridTextColumn Binding="{Binding Specialty}" Width="180">
          <DataGridTextColumn.Header><TextBlock Text="{loc:Loc Specialty}"/></DataGridTextColumn.Header>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
