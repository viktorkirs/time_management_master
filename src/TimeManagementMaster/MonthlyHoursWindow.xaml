<Window x:Class="TimeManagementMaster.MonthlyHoursWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TimeManagementMaster"
        Style="{StaticResource {x:Type Window}}" Title="{loc:Loc HoursReport}"
        Width="1180" Height="800" MinWidth="1000" MinHeight="650" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
      <TextBlock Text="{loc:Loc HoursReport}" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="{loc:Loc HoursReportHint}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
    </StackPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="{loc:Loc ExportCsv}" Click="Export_Click"/>
        <Button Content="{loc:Loc ExportDetails}" Click="ExportDetails_Click"/>
        <Button Content="{loc:Loc Print}" Click="Print_Click" Margin="0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Button Content="‹" Style="{StaticResource IconButton}" Click="Previous_Click"/>
        <Button Content="›" Style="{StaticResource IconButton}" Click="Next_Click" Margin="4,0,16,0"/>
        <TextBlock x:Name="MonthText" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <DatePicker x:Name="MonthPicker" Width="145" SelectedDateChanged="MonthChanged"/>
      </StackPanel>
    </DockPanel>
    <TextBlock DockPanel.Dock="Top" x:Name="TotalText" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc AbsenceDaysHint}" Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
    <Button DockPanel.Dock="Bottom" Content="{loc:Loc Close}" HorizontalAlignment="Right" IsCancel="True" Margin="0,16,0,0"/>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="190"/></Grid.RowDefinitions>
      <DataGrid x:Name="SummaryGrid" SelectionChanged="EmployeeChanged" RowHeight="44">
        <DataGrid.Columns>
          <DataGridTextColumn Binding="{Binding EmployeeName}" Width="*" MinWidth="180"><DataGridTextColumn.Header><TextBlock Text="{loc:Loc Employee}"/></DataGridTextColumn.Header></DataGridTextColumn>
          <DataGridTextColumn Binding="{Binding Specialty}" Width="140"><DataGridTextColumn.Header><TextBlock Text="{loc:Loc Specialty}"/></DataGridTextColumn.Header></DataGridTextColumn>
          <DataGridTextColumn Binding="{Binding AssignmentDays}" Width="115"><DataGridTextColumn.Header><TextBlock Text="{loc:Loc AssignedDays}" TextWrapping="Wrap"/></DataGridTextColumn.Header></DataGridTextColumn>
          <DataGridTextColumn Binding="{Binding MissingTimeDays}" Width="110"><DataGridTextColumn.Header><TextBlock Text="{loc:Loc MissingTimeDays}" TextWrapping="Wrap"/></DataGridTextColumn.Header></DataGridTextColumn>
          <DataGridTextColumn Binding="{Binding HoursText}" Width="120"><DataGridTextColumn.Header><TextBlock Text="{loc:Loc TotalHours}"/></DataGridTextColumn.Header></DataGridTextColumn>
          <DataGridTextColumn Binding="{Binding VacationDays}" Width="95"><DataGridTextColumn.Header><TextBlock Text="{loc:Loc Vacation}"/></DataGridTextColumn.Header></DataGridTextColumn>
          <DataGridTextColumn Binding="{Binding SickDays}" Width="120"><DataGridTextColumn.Header><TextBlock Text="{loc:Loc Sick}"/></DataGridTextColumn.Header></DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="1" Text="{loc:Loc ReportDetails}" Style="{StaticResource SectionLabel}" Margin="0,16,0,8"/>
      <DataGrid Grid.Row="2" x:Name="DetailsGrid" RowHeight="34">
        <DataGrid.Columns>
          <DataGridTextColumn Binding="{Binding DateText}" Width="115"><DataGridTextColumn.Header><TextBlock Text="{loc:Loc Dates}"/></DataGridTextColumn.Header></DataGridTextColumn>
          <DataGridTextColumn Binding="{Binding SiteName}" Width="*"><DataGridTextColumn.Header><TextBlock Text="{loc:Loc Site}"/></DataGridTextColumn.Header></DataGridTextColumn>
          <DataGridTextColumn Binding="{Binding StartText}" Width="130"><DataGridTextColumn.Header><TextBlock Text="{loc:Loc WorkStart}"/></DataGridTextColumn.Header></DataGridTextColumn>
          <DataGridTextColumn Binding="{Binding EndText}" Width="130"><DataGridTextColumn.Header><TextBlock Text="{loc:Loc WorkEnd}"/></DataGridTextColumn.Header></DataGridTextColumn>
          <DataGridTextColumn Binding="{Binding LunchText}" Width="160"><DataGridTextColumn.Header><TextBlock Text="{loc:Loc Lunch}"/></DataGridTextColumn.Header></DataGridTextColumn>
          <DataGridTextColumn Binding="{Binding HoursText}" Width="155"><DataGridTextColumn.Header><TextBlock Text="{loc:Loc TotalHours}"/></DataGridTextColumn.Header></DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</Window>
