<Window x:Class="TimeManagementMaster.CalendarEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TimeManagementMaster"
        Style="{StaticResource {x:Type Window}}" Title="{loc:Loc CalendarEntry}"
        Width="620" Height="800" MinWidth="560" MinHeight="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
      <TextBlock Text="{loc:Loc CalendarEntry}" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="{loc:Loc CalendarEntryHint}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{loc:Loc Cancel}" IsCancel="True" MinWidth="100"/>
        <Button x:Name="SaveButton" Content="{loc:Loc Save}" Style="{StaticResource PrimaryButton}" Click="Save_Click" MinWidth="130" Margin="0"/>
      </StackPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
      <StackPanel>
        <TextBlock Text="{loc:Loc Employee}" Style="{StaticResource FormLabel}"/>
        <ComboBox x:Name="EmployeeBox" DisplayMemberPath="FullName" SelectionChanged="EmployeeChanged"/>
        <TextBlock x:Name="CurrentText" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,16"/>
        <TextBlock Text="{loc:Loc Kind}" Style="{StaticResource FormLabel}"/>
        <ComboBox x:Name="KindBox" DisplayMemberPath="Title" SelectionChanged="KindChanged" Margin="0,0,0,16"/>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0"><TextBlock Text="{loc:Loc Start}" Style="{StaticResource FormLabel}"/><DatePicker x:Name="StartDate" SelectedDateChanged="DateChanged"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="{loc:Loc End}" Style="{StaticResource FormLabel}"/><DatePicker x:Name="EndDate"/></StackPanel>
        </Grid>
        <CheckBox x:Name="OpenBox" Content="{loc:Loc Ongoing}" Checked="OpenChanged" Unchecked="OpenChanged" Margin="0,0,0,12" Visibility="Collapsed"/>
        <StackPanel x:Name="WorkPanel">
          <CheckBox x:Name="WeekdaysBox" Content="{loc:Loc WeekdaysOnly}" IsChecked="True" Margin="0,0,0,12"/>
          <TextBlock Text="{loc:Loc Site}" Style="{StaticResource FormLabel}"/>
          <ComboBox x:Name="SiteBox" DisplayMemberPath="Name" Margin="0,0,0,16"/>
          <Border Background="{StaticResource PaperBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
            <loc:WorkTimeControl x:Name="TimeEditor"/>
          </Border>
        </StackPanel>
        <StackPanel x:Name="NotePanel" Visibility="Collapsed">
          <TextBlock Text="{loc:Loc NoteOther}" Style="{StaticResource FormLabel}"/>
          <TextBox x:Name="NoteBox" MaxLength="50"/>
        </StackPanel>
        <Button Content="{loc:Loc AllEmployeeAbsences}" HorizontalAlignment="Left" Margin="0,18,0,0" Click="Register_Click"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
