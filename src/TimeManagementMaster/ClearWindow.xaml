<Window x:Class="TimeManagementMaster.ClearWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        xmlns:local="clr-namespace:TimeManagementMaster"
        Title="{local:Loc ClearDays}" Height="620" Width="600" MinHeight="480" MinWidth="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="{local:Loc Cancel}" IsCancel="True" MinWidth="110"/>
      <Button Content="{local:Loc ClearAction}" Style="{StaticResource PrimaryButton}" MinWidth="120" Margin="0" Click="Save_Click"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="{local:Loc ClearIntro}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock Text="{local:Loc Employees}" Style="{StaticResource SectionLabel}"/>
        <local:EmployeeCheckList x:Name="People" Margin="0,6,0,8"/>
        <local:DateSelectionControl x:Name="Dates"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
