<Window x:Class="TimeManagementMaster.AssignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TimeManagementMaster"
        Style="{StaticResource {x:Type Window}}"
        Title="Assignment" Height="830" Width="1000" MinHeight="680" MinWidth="920"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{local:Loc Cancel}" IsCancel="True" MinWidth="110"/>
      <Button x:Name="SaveButton" Content="{local:Loc AssignPeople}" Style="{StaticResource PrimaryButton}" MinWidth="150" Margin="0" Click="Save_Click"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="{local:Loc AssignPeople}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock x:Name="HintText" Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
      <TextBlock Text="{local:Loc StepSite}" Style="{StaticResource SectionLabel}"/>
      <Grid Margin="0,8,0,24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="NewSiteButton" Grid.Column="1" Content="{local:Loc AddSite}" Margin="8,0,0,0" Click="AddSite_Click"/>
        <ComboBox x:Name="SiteBox" DisplayMemberPath="Name"/>
        <TextBlock x:Name="FixedSiteText" Visibility="Collapsed" Margin="0,4,0,4" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
      </Grid>
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
          <Button DockPanel.Dock="Right" Content="{local:Loc AddEmployee}" Margin="8,0,0,0" Click="AddEmployee_Click"/>
          <TextBlock Text="{local:Loc StepPeople}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
        </DockPanel>
        <local:EmployeeCheckList x:Name="People" VerticalAlignment="Top"/>
      </DockPanel>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
          <TextBlock Text="{local:Loc StepDates}" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
          <local:DateSelectionControl x:Name="Dates"/>
          <TextBlock Text="{local:Loc StepTime}" Style="{StaticResource SectionLabel}" Margin="0,24,0,10"/>
          <Border Background="{StaticResource PaperBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
            <local:WorkTimeControl x:Name="WorkTimeEditor"/>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
