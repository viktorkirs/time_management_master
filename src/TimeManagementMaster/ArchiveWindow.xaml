<Window x:Class="TimeManagementMaster.ArchiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        xmlns:loc="clr-namespace:TimeManagementMaster"
        Title="{loc:Loc Archive}" Height="480" Width="640" MinWidth="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="{loc:Loc Cancel}" IsCancel="True" MinWidth="110"/>
      <Button Content="{loc:Loc ArchiveVerb}" Style="{StaticResource DangerButton}" MinWidth="140" Margin="0" Click="Confirm_Click"/>
    </StackPanel>
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" x:Name="IntroText" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <ListBox x:Name="Lines"/>
    </DockPanel>
  </DockPanel>
</Window>
