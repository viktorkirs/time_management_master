<Window x:Class="TimeManagementMaster.EmployeesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        xmlns:loc="clr-namespace:TimeManagementMaster"
        Title="{loc:Loc Employees}" Height="560" Width="900" MinHeight="400" MinWidth="720"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <CheckBox DockPanel.Dock="Right" x:Name="ArchiveBox" Content="{loc:Loc ShowArchive}" VerticalAlignment="Center" Margin="12,0,0,0" Checked="Reload" Unchecked="Reload"/>
      <TextBox x:Name="SearchBox" TextChanged="Reload"/>
    </DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="{loc:Loc Add}" Style="{StaticResource PrimaryButton}" Click="Add_Click"/>
      <Button Content="{loc:Loc Edit}" Click="Edit_Click"/>
      <Button Content="{loc:Loc ToArchive}" Style="{StaticResource DangerButton}" Click="Archive_Click"/>
      <Button Content="{loc:Loc RestoreArchive}" Click="Restore_Click"/>
      <Button Content="{loc:Loc Close}" Margin="0" IsCancel="True"/>
    </StackPanel>
    <DataGrid x:Name="Grid" SelectionMode="Single" MouseDoubleClick="Edit_Click">
      <DataGrid.Columns>
        <DataGridTextColumn Binding="{Binding LastName}" Width="150">
          <DataGridTextColumn.Header><TextBlock Text="{loc:Loc LastName}"/></DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridTextColumn Binding="{Binding FirstName}" Width="130">
          <DataGridTextColumn.Header><TextBlock Text="{loc:Loc FirstName}"/></DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridTextColumn Binding="{Binding Specialty}" Width="*">
          <DataGridTextColumn.Header><TextBlock Text="{loc:Loc Specialty}"/></DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridTextColumn Binding="{Binding Phone}" Width="140">
          <DataGridTextColumn.Header><TextBlock Text="{loc:Loc Phone}"/></DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridTextColumn Binding="{Binding Note}" Width="160">
          <DataGridTextColumn.Header><TextBlock Text="{loc:Loc Note}"/></DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridCheckBoxColumn Binding="{Binding IsArchived, Mode=OneWay}" IsReadOnly="True" Width="80">
          <DataGridCheckBoxColumn.Header><TextBlock Text="{loc:Loc Archive}"/></DataGridCheckBoxColumn.Header>
        </DataGridCheckBoxColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
